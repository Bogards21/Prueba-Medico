# =============================================================================
# Terraza Mojito — variables de entorno
# Copia este archivo a .env.local y llénalo. Nunca subas .env.local al repo.
# =============================================================================

# --- Base de datos (Supabase) ------------------------------------------------
# Sin estas variables la app arranca en MODO DEMO: funciona, pero guarda los
# datos en memoria y los pierde al reiniciar. No sirve en producción.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. Ignora RLS, así que NUNCA le pongas el prefijo NEXT_PUBLIC_
# ni la uses desde un componente cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Acceso al Back Office ---------------------------------------------------
# AUTH_SECRET firma la cookie de sesión. Genera uno con:
#   openssl rand -base64 32
AUTH_SECRET=

# Credenciales del equipo. Si no defines ADMIN_PASSWORD en producción, el
# panel queda inaccesible a propósito.
ADMIN_USER=admin
ADMIN_PASSWORD=

STAFF_USER=staff
STAFF_PASSWORD=

# --- Contacto ----------------------------------------------------------------
# WhatsApp del negocio en formato internacional sin +, ej. 5217221234567
NEXT_PUBLIC_WHATSAPP=
